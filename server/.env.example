# Conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/inventory

# Secret para firmar los JWT (debe ser una cadena larga y aleatoria)
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_secreta_muy_larga

# Puerto donde corre el servidor (debe coincidir con VITE_API_URL del frontend)
PORT=5199

# Ruta donde se guardarán los PDFs de escrituras
UPLOADS_DIR=./uploads
